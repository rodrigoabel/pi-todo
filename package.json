{
  "name": "pi-todo",
  "version": "1.2.1",
  "description": "Persistent per-project todo tracker with live TUI widget for Pi — personal fork of mrg2400xx's pi-todo 1.2.0 that keeps completed tasks out of the widget",
  "author": "mrg2400xx",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigoabel/pi-todo.git"
  },
  "homepage": "https://github.com/rodrigoabel/pi-todo#readme",
  "bugs": {
    "url": "https://github.com/rodrigoabel/pi-todo/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "todo",
    "task-tracker",
    "productivity"
  ],
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  }
}
